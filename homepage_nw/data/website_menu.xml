<odoo noupdate="0">
    <function model="website.menu" name="unlink">
        <value
            model="website.menu"
            eval="obj().search([
                            ('url', '!=', '/default-main-menu'),
            ]).ids"
        />
    </function>

    <record id="main_menu" model="website.menu">
        <field name="name">Default Main Menu</field>
        <field name="url">/default-main-menu</field>
    </record>
    <record id="menu_home3" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="page_id" ref="homepage_nw.landing_page" />
        <field name="parent_id" ref="homepage_nw.main_menu" />
        <field name="sequence" type="int">10</field>
    </record>
    <record id="menu_contactus3" model="website.menu">
        <field name="name">Contact</field>
        <field name="url">/contactus</field>
        <field name="page_id" ref="homepage_nw.contactus_page" />
        <field name="parent_id" ref="homepage_nw.main_menu" />
        <field name="sequence" type="int">60</field>
    </record>
    <record id="menu_impressum" model="website.menu">
        <field name="name">Impressum</field>
        <field name="url">/impressum</field>
        <field name="page_id" ref="homepage_nw.impressum" />
        <field name="parent_id" ref="homepage_nw.main_menu" />
        <field name="sequence" type="int">80</field>
    </record>

    <record id="default_website" model="website">
        <field name="name">My Website NW</field>
        <field name="company_id" ref="base.main_company" />
        <field name="user_id" ref="base.public_user" />
    </record>
</odoo>
