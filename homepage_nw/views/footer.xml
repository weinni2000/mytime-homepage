                                        data-original-src="/homepage_nw/static/src/img/website/schwarzes-brett_inverted.png"
                                        data-mimetype-before-conversion="image/png"
                                        data-resize-width="500"
                                    />
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
